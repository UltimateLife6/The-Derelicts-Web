# Production origin. Leave unset on Vercel unless you have a custom domain ready.
# An empty value is treated as unset (do not set this to a blank string).
NEXT_PUBLIC_SITE_URL=

# Set when an email provider is wired. Leave empty to keep Join the Crew honest.
# Supported later: resend | sendgrid | mailchimp | convertkit | database
CREW_PROVIDER=

# Set to 1 only after a real analytics destination is connected.
NEXT_PUBLIC_ANALYTICS=
